[Unit]
Description=BashGames (FastAPI + WebSocket game server)
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=bashgames
Group=bashgames
WorkingDirectory=/opt/bashgames
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EnvironmentFile=/etc/bashgames/env
ExecStart=/opt/bashgames/venv/bin/uvicorn bg.main:app --app-dir /opt/bashgames \
  --host 127.0.0.1 --port 8300 --workers 1 \
  --proxy-headers --forwarded-allow-ips 127.0.0.1 \
  --no-server-header --no-access-log --ws websockets --ws-max-size 65536
Restart=always
RestartSec=5
UMask=0077
StateDirectory=bashgames
StateDirectoryMode=0700

MemoryHigh=250M
MemoryMax=400M
TasksMax=64

# Sandbox: read-only system; writable only /var/lib/bashgames (StateDirectory: VAPID key)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
